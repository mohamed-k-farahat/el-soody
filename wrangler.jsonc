{
  // Cloudflare Worker that serves the El Soody site, store and admin
  "name": "el-soody",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "el-soody-db",
      "database_id": "6b615cd5-d3a4-41ea-b0c4-56b4f928eebd",
      "migrations_dir": "migrations"
    }
  ],
  // MEDIA: photos uploaded in admin. SESSION: required by the Astro adapter.
  "kv_namespaces": [
    { "binding": "MEDIA", "id": "b1d9e3a17d3b44d29ebdb3e8407542f2" },
    { "binding": "SESSION", "id": "20fbb137c1de4f25973118affc487dfb" }
  ],
  "vars": {
    // "test" or "live" once Paymob keys are added as secrets. Local development uses "mock" from .dev.vars.
    "PAYMOB_MODE": "",
    // Cloudflare Access (admin login). Filled in at launch.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
  // Secrets (never in this file): PAYMOB_SECRET_KEY, PAYMOB_PUBLIC_KEY, PAYMOB_HMAC_SECRET, PAYMOB_INTEGRATION_IDS
  // Locally they go in .dev.vars; in production: wrangler secret put <NAME>
}
