---
// Delivery, payment, shop contact details and grind options
import Admin from '../../layouts/Admin.astro';
import { DB, getSettings, setSettings, getGrinds } from '../../lib/db.js';
import { toPiasters } from '../../lib/money.js';
import { paymobReady, paymobMode } from '../../lib/paymob.js';
import { str, flag } from '../../lib/admin.js';
import { storedHash, verifyPassword, hashPassword, setPasswordHash, makeSessionCookie } from '../../lib/auth.js';

const errors = [];
let pwMessage = '';
const form = Astro.request.method === 'POST' ? await Astro.request.formData() : null;

if (form && form.get('action') === 'password') {
  const current = String(form.get('current') || '');
  const fresh = String(form.get('fresh') || '');
  const hash = await storedHash();
  if (hash && !(await verifyPassword(current, hash))) pwMessage = 'كلمة السر الحالية غلط.';
  else if (fresh.length < 10) pwMessage = 'كلمة السر الجديدة لازم تكون ١٠ حروف على الأقل.';
  else if (fresh !== String(form.get('confirm') || '')) pwMessage = 'كلمتين السر الجداد مش زي بعض.';
  else {
    const newHash = await hashPassword(fresh);
    await setPasswordHash(newHash);
    // stay logged in on this device; every other device has to log in again
    return new Response(null, { status: 303, headers: { location: '/admin/settings?saved=1', 'set-cookie': await makeSessionCookie(newHash, Astro.url.protocol === 'https:') } });
  }
} else if (form) {
  const fee = toPiasters(form.get('delivery_fee'));
  const free = toPiasters(form.get('free_delivery_over'));
  if (Number.isNaN(fee) || Number.isNaN(free)) errors.push('مصاريف التوصيل لازم تكون رقم.');

  const values = {
    pickup_enabled: flag(form, 'pickup_enabled'),
    delivery_enabled: flag(form, 'delivery_enabled'),
    delivery_fee: fee ?? 0,
    free_delivery_over: free ?? 0,
    delivery_area_ar: str(form, 'delivery_area_ar', 200),
    delivery_area_en: str(form, 'delivery_area_en', 200),
    cod_enabled: flag(form, 'cod_enabled'),
    online_enabled: flag(form, 'online_enabled'),
    shop_phone: str(form, 'shop_phone', 30),
    shop_whatsapp: str(form, 'shop_whatsapp', 20).replace(/\D/g, ''),
    hours_ar: str(form, 'hours_ar', 200), hours_en: str(form, 'hours_en', 200),
    instagram: str(form, 'instagram', 300), facebook: str(form, 'facebook', 300), tiktok: str(form, 'tiktok', 300),
    order_email: str(form, 'order_email', 120),
    spice_addon_enabled: flag(form, 'spice_addon_enabled'),
    spice_addon_prices: ['125', '250', '1000'].map((s) => toPiasters(form.get(`spice_${s}`))).join(','),
  };
  if (values.spice_addon_enabled && !values.spice_addon_prices.split(',').every((n) => Number(n) > 0)) errors.push('اكتب سعر التحويجة لكل وزن: التُمن والربع والكيلو.');
  if (!values.pickup_enabled && !values.delivery_enabled) errors.push('لازم طريقة استلام واحدة على الأقل.');
  if (!values.cod_enabled && !values.online_enabled) errors.push('لازم طريقة دفع واحدة على الأقل.');
  for (const k of ['instagram', 'facebook', 'tiktok']) if (values[k] && !/^https:\/\//.test(values[k])) errors.push(`الرابط لازم يبدأ بـ https://`);

  // grinds
  const grinds = await getGrinds({ includeInactive: true });
  const grindOps = grinds.map((g) => DB().prepare('UPDATE grinds SET name_ar = ?, name_en = ?, active = ? WHERE id = ?')
    .bind(str(form, `grind_ar_${g.id}`, 60) || g.name_ar, str(form, `grind_en_${g.id}`, 60) || g.name_en, flag(form, `grind_on_${g.id}`), g.id));
  const newAr = str(form, 'grind_ar_new', 60);
  if (newAr) grindOps.push(DB().prepare('INSERT INTO grinds (name_ar, name_en, active, sort) VALUES (?, ?, 1, (SELECT coalesce(max(sort), 0) + 1 FROM grinds))').bind(newAr, str(form, 'grind_en_new', 60) || newAr));

  if (!errors.length) {
    await setSettings(values);
    if (grindOps.length) await DB().batch(grindOps);
    return Astro.redirect('/admin/settings?saved=1', 303);
  }
}

const s = await getSettings();
const grinds = await getGrinds({ includeInactive: true });
const pounds = (p) => (p ? String(Number(p) / 100) : '0');
const ready = paymobReady();
---
<Admin title="الإعدادات" active="settings">
  <div class="spread">
    <h1>الإعدادات</h1>
    <a class="btn" href="/admin/branches">الفروع والخريطة ←</a>
  </div>
  {errors.length > 0 && <div class="errors">{errors.map((e) => <div>{e}</div>)}</div>}

  <form method="post">
    <section class="card">
      <h2>الاستلام والتوصيل</h2>
      <div class="row" style="margin-bottom:.8rem">
        <label class="check"><input type="checkbox" name="pickup_enabled" checked={s.pickup}> استلام من المحل</label>
        <label class="check"><input type="checkbox" name="delivery_enabled" checked={s.delivery}> توصيل</label>
      </div>
      <div class="grid2">
        <label class="f">مصاريف التوصيل (جنيه)<input type="number" name="delivery_fee" value={pounds(s.delivery_fee)} min="0" step="0.5"></label>
        <label class="f">التوصيل مجاني للطلبات من (جنيه، ٠ = مفيش توصيل مجاني)<input type="number" name="free_delivery_over" value={pounds(s.free_delivery_over)} min="0" step="1"></label>
        <label class="f">بنوصّل فين؟ (بيظهر للعميل)<input type="text" name="delivery_area_ar" value={s.delivery_area_ar} placeholder="مثلا: الدقي والمهندسين والعجوزة"></label>
        <label class="f">Delivery area in English<input type="text" name="delivery_area_en" value={s.delivery_area_en} dir="ltr"></label>
      </div>
    </section>

    <section class="card">
      <h2>الدفع</h2>
      <div class="row">
        <label class="check"><input type="checkbox" name="cod_enabled" checked={s.cod}> كاش عند الاستلام</label>
        <label class="check"><input type="checkbox" name="online_enabled" checked={s.online}> دفع أونلاين (Paymob)</label>
      </div>
      {!ready && <p class="hint">الدفع الأونلاين مش هيظهر للعملاء لحد ما مفاتيح Paymob تتضاف للموقع.</p>}
      {ready && paymobMode() === 'mock' && <p class="hint">وضع تجربة: الدفع الأونلاين بيفتح صفحة دفع وهمية، مفيش فلوس حقيقية.</p>}
    </section>

    <section class="card">
      <h2>بيانات المحل</h2>
      <p class="hint">بتظهر في صفحة «كلّمنا» وصفحة المحل وتحت في كل صفحة. عناوين الفروع ومكانها على الخريطة في <a href="/admin/branches">صفحة الفروع</a>.</p>
      <div class="grid2">
        <label class="f">تليفون المحل<input type="tel" name="shop_phone" value={s.shop_phone} dir="ltr"></label>
        <label class="f">رقم الواتساب بكود الدولة (مثلا 201001234567)<input type="tel" name="shop_whatsapp" value={s.shop_whatsapp} dir="ltr"></label>
        <label class="f">مواعيد العمل بالعربي<input type="text" name="hours_ar" value={s.hours_ar} placeholder="مثلا: كل يوم من ٩ الصبح لـ ١٢ بالليل"></label>
        <label class="f">Opening hours in English<input type="text" name="hours_en" value={s.hours_en} dir="ltr"></label>
        <label class="f">إيميل يوصله إشعار بكل طلب جديد<input type="email" name="order_email" value={s.order_email} dir="ltr"><span class="hint">بيشتغل بعد ربط دومين المحل.</span></label>
        <label class="f">Instagram<input type="url" name="instagram" value={s.instagram} dir="ltr"></label>
        <label class="f">Facebook<input type="url" name="facebook" value={s.facebook} dir="ltr"></label>
        <label class="f">TikTok<input type="url" name="tiktok" value={s.tiktok} dir="ltr"></label>
      </div>
    </section>

    <section class="card">
      <h2>إضافة تحويجة للبن السادة</h2>
      <p class="hint">زي المنيو المطبوع «إضافة تحويجة (10-20-30)». العميل بيختار «بالتحويجة» وهو بيطلب بن سادة، والسعر بيتحسب على حسب الوزن.</p>
      <div class="row" style="margin-bottom:.8rem">
        <label class="check"><input type="checkbox" name="spice_addon_enabled" checked={s.spice_addon_enabled === '1'}> شغالة</label>
      </div>
      <div class="grid3">
        {[['125', 'التُمن'], ['250', 'الربع'], ['1000', 'الكيلو']].map(([size, label], i) => (
          <label class="f">{label} (جنيه)<input type="number" name={`spice_${size}`} min="0" step="0.5" value={(Number(String(s.spice_addon_prices || '').split(',')[i]) || 0) / 100 || ''}></label>
        ))}
      </div>
    </section>

    <section class="card">
      <h2>اختيارات الطحنة</h2>
      <div class="tablewrap">
        <table class="t t--grid">
          <thead><tr><th>بالعربي</th><th>English</th><th>ظاهر</th></tr></thead>
          <tbody>
            {grinds.map((g) => (
              <tr>
                <td><input type="text" name={`grind_ar_${g.id}`} value={g.name_ar} aria-label="بالعربي"></td>
                <td><input type="text" name={`grind_en_${g.id}`} value={g.name_en} dir="ltr" aria-label="English"></td>
                <td class="tick"><label class="check"><input type="checkbox" name={`grind_on_${g.id}`} checked={!!g.active} aria-label="ظاهر"><span class="show-sm">ظاهر</span></label></td>
              </tr>
            ))}
            <tr class="newrow">
              <td><input type="text" name="grind_ar_new" placeholder="طحنة جديدة" aria-label="طحنة جديدة بالعربي"></td>
              <td><input type="text" name="grind_en_new" placeholder="New grind" dir="ltr" aria-label="New grind in English"></td>
              <td class="hide-sm"></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <div class="savebar"><button class="btn btn--primary">احفظ الإعدادات</button></div>
  </form>

  <form method="post" class="card">
    <h2>كلمة سر لوحة التحكم</h2>
    {pwMessage && <p class="errors" role="alert">{pwMessage}</p>}
    <input type="hidden" name="action" value="password">
    <div class="grid2">
      <label class="f">كلمة السر الحالية<input type="password" name="current" autocomplete="current-password" dir="ltr"></label>
      <span></span>
      <label class="f">كلمة السر الجديدة (١٠ حروف على الأقل)<input type="password" name="fresh" autocomplete="new-password" minlength="10" dir="ltr"></label>
      <label class="f">اكتبها تاني<input type="password" name="confirm" autocomplete="new-password" minlength="10" dir="ltr"></label>
    </div>
    <p class="hint">بعد التغيير، أي جهاز تاني كان داخل هيطلب كلمة السر الجديدة.</p>
    <button class="btn">غيّر كلمة السر</button>
  </form>
</Admin>
