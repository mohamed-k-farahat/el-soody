---
// All products, including hidden ones
import Admin from '../../../layouts/Admin.astro';
import { DB, mapProduct } from '../../../lib/db.js';
import { imageUrl } from '../../../lib/images.js';

const { results: products } = await DB().prepare(`
  SELECT p.id, p.slug, p.name_ar, p.name_en, p.kind, p.image, p.photos, p.active, p.in_book, p.sort,
         (SELECT count(*) FROM items i WHERE i.product_id = p.id) AS rows
  FROM products p ORDER BY p.sort, p.id`).all();
---
<Admin title="المنتجات" active="products">
  <div class="spread">
    <h1>المنتجات</h1>
    <a class="btn btn--primary" href="/admin/products/new">+ منتج جديد</a>
  </div>
  <div class="tablewrap">
    <table class="t">
      <thead><tr><th></th><th>المنتج</th><th class="hide-sm">في الكتاب</th><th class="hide-sm">سطور المنيو</th><th>الحالة</th><th class="hide-sm"></th></tr></thead>
      <tbody>
        {products.map((p) => (
          <tr>
            <td><img class="thumb" src={imageUrl(mapProduct(p).photos[0] || p.image)} alt="" loading="lazy"></td>
            <td><a class="rowlink" href={`/admin/products/${p.id}`}>{p.name_ar}</a><br><span class="hint">{p.name_en}</span></td>
            <td class="hide-sm">{p.in_book ? 'أيوه' : 'لأ'}</td>
            <td class="hide-sm">{p.rows}</td>
            <td>{p.active ? <span class="st st--completed">ظاهر</span> : <span class="st st--cancelled">مخفي</span>}</td>
            <td class="hide-sm"><a class="btn btn--small" href={`/admin/products/${p.id}`}>تعديل</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Admin>
