---
import Base from '../layouts/Base.astro';
import { t } from '../lib/i18n.js';
import { getSettings } from '../lib/db.js';

const { lang } = Astro.props;
const tr = (k) => t(lang, k);
const s = await getSettings();

const address = s[`address_${lang}`] || s.address_ar;
const hours = s[`hours_${lang}`] || s.hours_ar;
const info = [
  address && { icon: 'pin', label: tr('visit.address'), text: address, link: s.maps_url },
  !address && s.maps_url && { icon: 'pin', label: tr('visit.address'), text: tr('visit.map'), link: s.maps_url },
  hours && { icon: 'clock', label: tr('visit.hours'), text: hours },
  s.shop_phone && { icon: 'phone', label: tr('visit.phone'), text: s.shop_phone, link: `tel:${s.shop_phone.replace(/\s/g, '')}`, ltr: true },
].filter(Boolean);
const socials = [
  s.shop_whatsapp && ['whatsapp', `https://wa.me/${s.shop_whatsapp}`, 'WhatsApp'],
  s.instagram && ['instagram', s.instagram, 'Instagram'],
  s.facebook && ['facebook', s.facebook, 'Facebook'],
  s.tiktok && ['tiktok', s.tiktok, 'TikTok'],
].filter(Boolean);

const ICONS = {
  pin: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>',
  clock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
  phone: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z"/></svg>',
  whatsapp: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2s.2-1.1.2-1.2-.2-.2-.5-.3z"/></svg>',
  instagram: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>',
  facebook: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H8v4h2v8h4v-8h3l1-4h-4V8z"/></svg>',
  tiktok: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 3c.3 2.2 1.7 3.8 4 4v3.2a7.6 7.6 0 0 1-4-1.2V15a6 6 0 1 1-6-6h.6v3.3H10a2.7 2.7 0 1 0 2.7 2.7V3H16z"/></svg>',
};
---
<Base lang={lang} page="shop">
  <section class="section shop shop--film">
    <div class="container film-wrap">
      <div class="film-wrap__text reveal">
        <p class="eyebrow">{tr('film.eyebrow')}</p>
        <h1 class="h2">{tr('film.title')}</h1>
        <p>{tr('film.lead')}</p>
      </div>

      <!-- Soody branded player (controls stay left to right in both languages, like a timeline) -->
      <div class="player reveal" id="player" dir="ltr">
        <video id="playerVideo" playsinline preload="metadata" poster="/media/promo-poster.jpg">
          <source src="/media/promo.mp4" type="video/mp4">
        </video>
        <span class="player__mark logo-mark" aria-hidden="true"></span>
        <button class="player__big" id="playerBig" type="button" aria-label={tr('player.play')}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg>
        </button>
        <div class="player__bar">
          <button class="player__btn" id="playerToggle" type="button" aria-label={tr('player.play')}>
            <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg>
            <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"/></svg>
          </button>
          <span class="player__time" id="playerTime">0:00</span>
          <div class="player__track" id="playerTrack" role="slider" tabindex="0" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label={tr('player.seek')}>
            <span class="player__buffer" id="playerBuffer"></span>
            <span class="player__fill" id="playerFill"></span>
            <span class="player__thumb" id="playerThumb"></span>
          </div>
          <span class="player__time" id="playerDur">0:00</span>
          <button class="player__btn" id="playerMute" type="button" aria-label={tr('player.mute')}>
            <svg class="i-vol" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor"/><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            <svg class="i-muted" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor"/><path d="M16 9.5l5 5M21 9.5l-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </button>
          <button class="player__btn" id="playerFull" type="button" aria-label={tr('player.full')}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  {(info.length > 0 || socials.length > 0) && (
    <section class="section visit" id="visit">
      <div class="container">
        <div class="visit__text">
          <p class="eyebrow">{tr('visit.eyebrow')}</p>
          <h2 class="h2">{tr('visit.title')}</h2>
          <ul class="visit__info">
            {info.map((i) => (
              <li>
                <span class="ico" set:html={ICONS[i.icon]} />
                <span><b>{i.label}</b>{i.link ? <a href={i.link} dir={i.ltr ? 'ltr' : undefined} target={i.link.startsWith('http') ? '_blank' : undefined} rel="noopener">{i.text}</a> : i.text}</span>
              </li>
            ))}
          </ul>
          <div class="socials">
            {socials.map(([icon, url, label]) => <a href={url} target="_blank" rel="noopener" aria-label={label} set:html={ICONS[icon]} />)}
          </div>
        </div>
      </div>
    </section>
  )}

  <script slot="scripts" is:inline src="/js/player.js"></script>
</Base>
